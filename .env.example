# Video generation
FAL_KEY=
FAL_MODEL=minimax/h3-max/text-to-video
CLIP_DURATION=15
CLIP_MIN_DURATION=5
MAX_TOTAL_DURATION=45   # >15s renders as chained scenes merged into one mp4
CLIP_RESOLUTION=768P

# Moderation and writing
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5   # default: cheapest/fastest; set claude-opus-5 for a smarter writers room

# Voltage Payments API
VOLTAGE_API_KEY=
VOLTAGE_ORG_ID=
VOLTAGE_ENV_ID=
VOLTAGE_WALLET_ID=
VOLTAGE_API_URL=https://voltageapi.com/v1

# Returned once when the Voltage environment webhook is created
VOLTAGE_WEBHOOK_ID=
VOLTAGE_WEBHOOK_SECRET=

# Sent by Vercel to authenticate the scheduled payment reconciliation route
CRON_SECRET=

# Submission price (set PRICE_SATS, or leave it at 0 to convert PRICE_USD)
PRICE_SATS=0
PRICE_USD=2.0
# Cost floor: never sell below (estimated cost × PRICE_MARKUP). Rates are
# fal list prices at 768P; promo rates ($0.02/s) expire 2026-09-07 (video)
# and 2026-09-14 (director).
FAL_VIDEO_USD_PER_SEC=0.08
FAL_DIRECTOR_USD_PER_SEC=0.08
FAL_DIRECTOR_MIN_SEC=60
SCENE_OVERHEAD_USD=0.02
SANDBOX_USD_PER_EPISODE=0.05
LLM_USD_PER_JOB=0.02
PRICE_MARKUP=1.5

# Persistent production store
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# House content
MAX_DAILY_HOUSE_CLIPS=12
MIN_LIBRARY_CLIPS=3
HOUSE_FRESH_HOURS=4

# Live chat (nostr, NIP-53 kind 1311 on public relays). Off by default;
# any URL with ?chat=1 also turns it on for that visit.
NEXT_PUBLIC_CHAT_ENABLED=0

# --- H3 Max Director tier (optional) ---
# Longest purchasable episode as ONE continuous Director take. 0 = off.
# Episodes above MAX_TOTAL_DURATION (45) and up to this are recorded by the
# recorder worker (recorder/), which must be running somewhere with FAL_KEY.
DIRECTOR_MAX_DURATION=0
# Shared secret between the app and the recorder worker (any long random string).
RECORDER_SECRET=
FAL_DIRECTOR_MODEL=minimax/h3-max/director
# Record director episodes in a per-job Vercel Sandbox (no always-on worker).
RECORDER_SANDBOX=0
# Optional: snapshot id from `node recorder/sandbox-snapshot.mjs` (fast boots).
RECORDER_SANDBOX_SNAPSHOT=
# Optional: where the sandbox fetches the recorder (defaults: this repo at the
# deployed commit) and how long a VM may live.
# RECORDER_REPO_URL=https://github.com/ATLBitLab/infinite.git
# RECORDER_REPO_REF=main
# RECORDER_SANDBOX_TIMEOUT_MS=600000
# Local runs only (Vercel deployments authenticate the Sandbox SDK via OIDC):
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# Public origin the sandbox recorder calls back to (default: the Vercel
# production URL, or http://localhost:3000).
# INFINITE_URL=

# --- Clip archive: Cloudflare R2 (optional, all five required to enable) ---
# Copies every finished mp4 out of fal's CDN into a bucket we own.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=infinite-clips
# Public base URL of the bucket (r2.dev subdomain or custom domain), no trailing slash.
R2_PUBLIC_URL=
