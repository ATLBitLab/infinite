{
  "name": "infinite-recorder",
  "private": true,
  "type": "module",
  "description": "Records fal H3 Max Director sessions into mp4 clips for INFINITE",
  "scripts": {
    "build": "esbuild harness.ts --bundle --format=iife --platform=browser --target=chrome120 --outfile=dist/harness.js",
    "start": "npm run build && node index.mjs",
    "once": "npm run build && node index.mjs --once"
  },
  "dependencies": {
    "@fal-ai/client": "^1.11.0-alpha.2",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
